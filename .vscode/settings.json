{
    // General editor settings
    "window.commandCenter": true,   // search box at top of window
    "editor.colorDecorators": true, // show colour pickers in code

    // Hide noise from the Explorer sidebar
    "files.exclude": {
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true
    },


    // 🐍 UV PYTHON ENVIRONMENT
    // Run `uv sync` to create .venv/ → IDE auto-detects the interpreter below
    // Modern uv convention: don't activate venv, run commands via `uv run <cmd>`
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false, // don't auto-activate; use `uv run`

    // 🐍 Ruff: Python code linting and formatting 
    // This configures HOW the IDE behaves
    // NB: WHAT to check in pyproject.toml Pylance(VSCode)/Pyright(Cursor)
    
    // Ruff extension settings
    "ruff.nativeServer": "on",  // Use faster Rust-based server
    
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },

    // 📝 Markdownlint: Markdown linting (matches CodeRabbit's checks)
    "[markdown]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    },
}